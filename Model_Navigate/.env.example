# ============================================
# Model Navigate - 环境变量配置（脱敏参数）
# ============================================
# 复制本文件为 .env 并填入你的 API Key
# cp .env.example .env
#
# 参数分三层管理：
#   .env（本文件）→ API Key、Webhook、Token、API Base URL
#   config.py     → 数据源 URL、超时、UA、数据常量、阈值等
#   各脚本内部    → 不变的核心逻辑
#
# 详细说明见 README.md 的"配置管理"章节

# ── 钉钉日报推送 ──
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
DINGTALK_SECRET=SEC_YOUR_SECRET

# ── 主 LLM API（kuai — 用于 LLM 提取和审核）──
KUAI_API_KEY=sk-xxx
KUAI_API_BASE=https://api.kuai.host/v1
KUAI_MODEL=claude-opus-4-6
REVIEW_MODEL=gpt-5.5

# ── 备选 LLM API（DashScope 百炼 — Qwen，提取失败时 fallback）──
LLM_API_KEY=sk-xxx
# TRACKER_FIELD_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ── HuggingFace（用于开源模型交叉校验，可选）──
# HF_TOKEN=hf_xxx

# ============================================
# 平台模型目录采集（通用适配器框架）
# ============================================
# 只需配置 API_BASE + API_KEY 即可启用对应平台的模型目录采集。
# 未配置的平台会自动跳过，不影响其他平台。
# 使用方式：python auto_collect.py --source platform

# ── 官方平台（已通过 DashScope/LLM_API_BASE 配置，无需重复）──

# ── 硅基流动 SiliconFlow（聚合大量开源模型）──
# SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
# SILICONFLOW_API_KEY=sk-xxx

# ── DeepSeek 官方 ──
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=sk-xxx

# ── 火山引擎（字节跳动豆包系列）──
# VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_API_KEY=xxx

# ── MiniMax（海螺、通用对话等）──
# MINIMAX_API_BASE=https://api.minimaxi.com/v1
# MINIMAX_API_KEY=xxx

# ── 腾讯混元 ──
# HUNYUAN_API_BASE=https://api.hunyuan.cloud.tencent.com/v1
# HUNYUAN_API_KEY=sk-xxx

# ── 阶跃星辰 StepFun ──
# STEPFUN_API_BASE=https://api.stepfun.com/v1
# STEPFUN_API_KEY=xxx

# ── Moonshot 月之暗面（Kimi）──
# MOONSHOT_API_BASE=https://api.moonshot.cn/v1
# MOONSHOT_API_KEY=sk-xxx

# ── 智谱 Zhipu（GLM 系列）──
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_API_KEY=xxx

# ── 百度千帆（ERNIE 系列，自定义 REST API）──
# QIANFAN_API_BASE=https://qianfan.baidubce.com
# QIANFAN_API_KEY=xxx

# ── 聚合平台（兜底补充源，覆盖遗漏）──

# ── OpenRouter（全球 500+ 模型聚合）──
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-xxx

# ── 酷爱 Kuai（国内外模型聚合代理）──
# KUAI_API_BASE=https://api.kuai.host/v1
# KUAI_API_KEY=sk-xxx
