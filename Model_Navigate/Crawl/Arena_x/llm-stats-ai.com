 async workloads, blended price per 1M tokens is usually the better axis.\"}}]}]]}]\n"])</script><script>self.__next_f.push([1,"3f:[\"$\",\"details\",\"faq-best-open\",{\"id\":\"faq-best-open\",\"open\":false,\"className\":\"group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [\u0026_.faq-icon]:open:rotate-45\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [\u0026::-webkit-details-marker]:hidden\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90\",\"children\":\"Which is the best open-source AI model?\"}],[\"$\",\"span\",null,{\"className\":\"faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 pr-14 sm:px-6 sm:pr-20\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [\u0026_a]:font-medium [\u0026_a]:text-black/85 [\u0026_a]:underline [\u0026_a]:underline-offset-2 [\u0026_a]:decoration-black/20 hover:[\u0026_a]:decoration-black/80 dark:[\u0026_a]:text-white/85 dark:[\u0026_a]:decoration-white/20 dark:hover:[\u0026_a]:decoration-white/80 [\u0026_strong]:font-medium [\u0026_strong]:text-black/92 dark:[\u0026_strong]:text-white/92\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cstrong\u003eKimi K3\u003c/strong\u003e currently leads among open-weights LLMs (93.5% gpqa). The open-weights ecosystem is dominated by Llama, Qwen, DeepSeek, Mistral, GLM and Gemma. The dedicated \u003ca href=\\\"/leaderboards/open-llm-leaderboard\\\"\u003eOpen LLM Leaderboard\u003c/a\u003e filters this catalog to models with publicly released weights so you can self-host or fine-tune.\"}}]}]]}]\n"])</script><script>self.__next_f.push([1,"40:[\"$\",\"details\",\"faq-llm-stats-score\",{\"id\":\"faq-llm-stats-score\",\"open\":false,\"className\":\"group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [\u0026_.faq-icon]:open:rotate-45\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [\u0026::-webkit-details-marker]:hidden\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90\",\"children\":\"How is the LLM Stats Score calculated?\"}],[\"$\",\"span\",null,{\"className\":\"faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"aria-hidden\":true,\"c