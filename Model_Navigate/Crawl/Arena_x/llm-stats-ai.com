d-lg bg-black/[0.015] dark:bg-white/[0.015]" style="height:650px"></div></div></div><div class="border-t border-black/[0.05] dark:border-white/[0.06]"><div class="" style="min-height:500px"><div class="w-full rounded-lg bg-black/[0.015] dark:bg-white/[0.015]" style="height:500px"></div></div></div><div class="border-t border-black/[0.05] dark:border-white/[0.06]"><div class="" style="min-height:400px"><div class="w-full rounded-lg bg-black/[0.015] dark:bg-white/[0.015]" style="height:400px"></div></div></div><div class="border-t border-black/[0.05] dark:border-white/[0.06]"><div class="" style="min-height:300px"><div class="w-full rounded-lg bg-black/[0.015] dark:bg-white/[0.015]" style="height:300px"></div></div></div><div class="border-t border-black/[0.05] dark:border-white/[0.06]"><div class="" style="min-height:120px"><div class="w-full rounded-lg bg-black/[0.015] dark:bg-white/[0.015]" style="height:120px"></div></div></div><div class="border-t border-black/[0.05] dark:border-white/[0.06]"><div class="" style="min-height:600px"><div class="w-full rounded-lg bg-black/[0.015] dark:bg-white/[0.015]" style="height:600px"></div></div></div><div class="border-t border-black/[0.05] dark:border-white/[0.06]"><div class="" style="min-height:400px"><div class="w-full rounded-lg bg-black/[0.015] dark:bg-white/[0.015]" style="height:400px"></div></div></div><section id="llm-leaderboard-faq" aria-labelledby="leaderboard-seo-heading" class="border-t border-black/[0.05] dark:border-white/[0.06]"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Dataset","name":"LLM Stats Leaderboard — AI Models with Live Pricing & Benchmarks","description":"The LLM Leaderboard ranks 300+ AI models by intelligence, output speed, latency and per-token pricing. Independent benchmark scores aggregated into the LLM Stats Score, refreshed continuously from provider APIs and verified evaluations.","url":"https://llm-stats.com/","creator":{"@type":"Organization","name":"LLM Stats","url":"https://llm-stats.com"},"publisher":{"@id":"https://llm-stats.com/#organization"},"measurementTechnique":"Aggregated benchmark scores from public model evaluations and provider-reported results.","spatialCoverage":"Worldwide","isAccessibleForFree":true,"license":"https://llm-stats.com/legal/terms-of-service","citation":"LLM Stats (2026). LLM benchmark and pricing dataset. https://llm-stats.com","keywords":["ai leaderboard","ai rankings","ai model comparison","best ai models","top ai models","ai benchmarks","llm rankings","best llm","llm pricing"],"variableMeasured":["LLM Stats Score","GPQA Diamond","SWE-Bench Verified","Coding Arena Score","Output throughput (tokens/sec)","Time to first token (s)","Input price (USD per 1M tokens)","Output price (USD per 1M tokens)","Context window (tokens)","License (open weights vs proprietary)"],"dateModified":"2026-07-17T01:08:52.446Z","distribution":[{"@type":"DataDownload","name":"Models list (JSON)","contentUrl":"https://api.zeroeval.com/leaderboard/models/list","encodingFormat":"application/json"},{"@type":"DataDownload","name":"Per-model live metrics (JSON)","contentUrl":"https://api.zeroeval.com/v1/models/metrics","encodingFormat":"application/json"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which AI model ranks #1 on the LLM Leaderboard?","acceptedAnswer":{"@type":"Answer","text":"On the LLM Stats Leaderboard, GPT-5.6 Sol currently leads on GPQA Diamond (94.6% gpqa), the most discriminating reasoning benchmark at the frontier. This AI leaderboard ranks models by the LLM Stats Score, which aggregates GPQA, SWE-Bench Verified, coding-arena performance and pricing into one comparable AI ranking. Rankings refresh continuously as new benchmark results land."}},{"@type":"Question","name":"What is the best AI model right now?","acceptedAnswer":{"@type":"Answer","text":"\"Best\" depends on what you're optimizing for. For frontier reasoning, GPT-5.6 Sol leads on GPQA. For coding agents, Gemini 3.1 Pro is the strongest in head-to-head coding-arena play. For low cost at frontier quality, Grok 4.5 is the cheapest in the top 10 at $2.00 /M tok. The leaders summary above the table names the current winner per axis."}},{"@type":"Question","name":"What are the best LLMs in 2026?","acceptedAnswer":{"@type":"Answer","text":"The leading LLMs in 2026 are GPT-5.6 Sol, Gemini 3.1 Pro, and the frontier models from OpenAI (GPT-5 family), Anthropic (Claude Opus and Sonnet), Google (Gemini 3 Pro), xAI (Grok 4), DeepSeek (V3 / R1) and Z.AI (GLM-5). Open-weights leaders include Llama, Qwen and DeepSeek. The full ranking is in the leaderboard table above."}},{"@type":"Question","name":"What is the cheapest AI model in the top 10?","acceptedAnswer":{"@type":"Answer","text":"Grok 4.5 is the cheapest model in the top 10 by GPQA Diamond, at $2.00 /M tok input. The Cheapest filter on the leaderboard restricts to verified, currently-available frontier models — pricing is pulled from each provider's public price list and cross-checked against billing samples through the LLM Stats proxy."}},{"@type":"Question","name":"Which AI model has the largest context window?","acceptedAnswer":{"@type":"Answer","text":"Grok-4.1 Fast Non-Reasoning currently exposes the largest practical context window at 2.0M tokens tokens. Larger context lets you keep more documents, conversation history and tool traces in a single request. For long-document workloads, also consult the per-model \"effective context\" notes on each model detail page — providers vary in how well they actually use the upper end of their advertised windows."}},{"@type":"Question","name":"What is the fastest LLM by output speed?","acceptedAnswer":{"@type":"Answer","text":"Mercury 2 currently has the highest output throughput at 713 tok/s. Output speed is measured by routing standardized prompts through each provider's API and averaging tokens-per-second over a 7-day rolling window. Fast inference matters most for streaming chat UIs and agentic loops; for batched async workloads, blended price per 1M tokens is usually the better axis."}},{"@type":"Question","name":"Which is the best open-source AI model?","acceptedAnswer":{"@type":"Answer","text":"GLM-5.2 currently leads among open-weights LLMs (91.2% gpqa). The open-weights ecosystem is dominated by Llama, Qwen, DeepSeek, Mistral, GLM and Gemma. The dedicated Open LLM Leaderboard filters this catalog to models with publicly released weights so you can self-host or fine-tune."}},{"@type":"Question","name":"How is the LLM Stats Score calculated?","acceptedAnswer":{"@type":"Answer","text":"The LLM Stats Score is a composite that blends verified benchmark results (GPQA Diamond, SWE-Bench Verified, coding-arena), live performance metrics (output throughput, time-to-first-token) and per-token pricing into one comparable number. Pricing and metadata revalidate hourly; live performance updates on a 7-day rolling average. For the full weighting and refresh cadence see the LLM Stats Score methodology. 329 canonical models are tracked across every major lab and inference provider."}}]}</script><div class="mx-auto grid w-full max-w-[1200px] grid-cols-1 gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[340px_minmax(0,1fr)] lg:gap-16 lg:px-8"><aside class="lg:sticky lg:top-24 lg:self-start"><div class="text-[10px] font-medium uppercase tracking-[0.14em] text-black/35 dark:text-white/35">Leaderboard guide</div><h2 id="leaderboard-seo-heading" class="mt-2 text-[22px] sm:text-[26px] font-medium leading-[1.1] tracking-[-0.02em] text-black/92 dark:text-white/92">Compare the best AI models with one independent score.</h2><p class="mt-3 text-[13px] leading-[1.65] text-black/55 dark:text-white/55">The LLM Stats leaderboard ranks GPT, Claude, Gemini, Llama, DeepSeek, Qwen, Mistral, GLM and more by intelligence, speed and price. Every score is sourced from public benchmarks and live API metrics.</p><nav class="mt-6 flex flex-col" aria-label="Leaderboard guide"><a class="group flex items-center justify-between gap-4 border-t border-black/[0.06] px-1 py-3 transition-colors first:border-t-0 hover:bg-black/[0.012] dark:border-white/[0.08] dark:hover:bg-white/[0.02]" href="/leaderboards/llm-leaderboard"><span class="min-w-0"><span class="block truncate text-[13px] font-medium tracking-[-0.005em] text-black/90 dark:text-white/90">Full LLM Leaderboard</span><span class="mt-0.5 block truncate text-[12px] text-black/50 dark:text-white/50">All 300+ models with advanced filters</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3 w-3 shrink-0 text-black/35 transition-transform group-hover:translate-x-0.5 group-hover:text-black/80 dark:text-white/35 dark:group-hover:text-white/80" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="group flex items-center justify-between gap-4 border-t border-black/[0.06] px-1 py-3 transition-colors first:border-t-0 hover:bg-black/[0.012] dark:border-white/[0.08] dark:hover:bg-white/[0.02]" href="/methodology/llm-stats-score"><span class="min-w-0"><span class="block truncate text-[13px] font-medium tracking-[-0.005em] text-black/90 dark:text-white/90">Read the methodology</span><span class="mt-0.5 block truncate text-[12px] text-black/50 dark:text-white/50">How the LLM Stats Score is computed</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3 w-3 shrink-0 text-black/35 transition-transform group-hover:translate-x-0.5 group-hover:text-black/80 dark:text-white/35 dark:group-hover:text-white/80" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="group flex items-center justify-between gap-4 border-t border-black/[0.06] px-1 py-3 transition-colors first:border-t-0 hover:bg-black/[0.012] dark:border-white/[0.08] dark:hover:bg-white/[0.02]" href="/models/compare"><span class="min-w-0"><span class="block truncate text-[13px] font-medium tracking-[-0.005em] text-black/90 dark:text-white/90">Compare two models</span><span class="mt-0.5 block truncate text-[12px] text-black/50 dark:text-white/50">Pricing, context, speed and benchmark scores</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3 w-3 shrink-0 text-black/35 transition-transform group-hover:translate-x-0.5 group-hover:text-black/80 dark:text-white/35 dark:group-hover:text-white/80" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="group flex items-center justify-between gap-4 border-t border-black/[0.06] px-1 py-3 transition-colors first:border-t-0 hover:bg-black/[0.012] dark:border-white/[0.08] dark:hover:bg-white/[0.02]" href="/benchmarks"><span class="min-w-0"><span class="block truncate text-[13px] font-medium tracking-[-0.005em] text-black/90 dark:text-white/90">Explore benchmarks</span><span class="mt-0.5 block truncate text-[12px] text-black/50 dark:text-white/50">MMLU, GPQA, SWE-Bench, AIME and more</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3 w-3 shrink-0 text-black/35 transition-transform group-hover:translate-x-0.5 group-hover:text-black/80 dark:text-white/35 dark:group-hover:text-white/80" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></nav></aside><div class="min-w-0"><section id="faq" class="space-y-6" aria-labelledby="faq-heading"><header class="max-w-3xl"><h2 id="faq-heading" class="text-[22px] sm:text-[26px] font-medium leading-[1.1] tracking-[-0.02em] text-black/92 dark:text-white/92">FAQ</h2><p class="mt-2 text-[13px] leading-[1.65] text-black/70 dark:text-white/70">Quick answers for choosing, comparing and interpreting today&#x27;s leading AI models.</p></header><div class="overflow-hidden rounded-xl border border-black/[0.06] bg-white dark:border-white/[0.08] dark:bg-white/[0.02]"><details id="faq-rank-1" open="" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">Which AI model ranks #1 on the LLM Leaderboard?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92">On the LLM Stats Leaderboard, <strong>GPT-5.6 Sol</strong> currently leads on GPQA Diamond (94.6% gpqa), the most discriminating reasoning benchmark at the frontier. This AI leaderboard ranks models by the LLM Stats Score, which aggregates GPQA, SWE-Bench Verified, coding-arena performance and pricing into one comparable AI ranking. Rankings refresh continuously as new benchmark results land.</div></div></details><details id="faq-best-now" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">What is the best AI model right now?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92">"Best" depends on what you're optimizing for. For frontier reasoning, <strong>GPT-5.6 Sol</strong> leads on GPQA. For coding agents, <strong>Gemini 3.1 Pro</strong> is the strongest in head-to-head coding-arena play. For low cost at frontier quality, <strong>Grok 4.5</strong> is the cheapest in the top 10 at $2.00 /M tok. The leaders summary above the table names the current winner per axis.</div></div></details><details id="faq-best-llms-2026" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">What are the best LLMs in 2026?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92">The leading LLMs in 2026 are <strong>GPT-5.6 Sol</strong>, <strong>Gemini 3.1 Pro</strong>, and the frontier models from OpenAI (GPT-5 family), Anthropic (Claude Opus and Sonnet), Google (Gemini 3 Pro), xAI (Grok 4), DeepSeek (V3 / R1) and Z.AI (GLM-5). Open-weights leaders include Llama, Qwen and DeepSeek. The full ranking is in the leaderboard table above.</div></div></details><details id="faq-cheapest-frontier" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">What is the cheapest AI model in the top 10?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92"><strong>Grok 4.5</strong> is the cheapest model in the top 10 by GPQA Diamond, at $2.00 /M tok input. The Cheapest filter on the leaderboard restricts to verified, currently-available frontier models — pricing is pulled from each provider's public price list and cross-checked against billing samples through the LLM Stats proxy.</div></div></details><details id="faq-largest-context" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">Which AI model has the largest context window?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92"><strong>Grok-4.1 Fast Non-Reasoning</strong> currently exposes the largest practical context window at 2.0M tokens tokens. Larger context lets you keep more documents, conversation history and tool traces in a single request. For long-document workloads, also consult the per-model "effective context" notes on each model detail page — providers vary in how well they actually use the upper end of their advertised windows.</div></div></details><details id="faq-fastest" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">What is the fastest LLM by output speed?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92"><strong>Mercury 2</strong> currently has the highest output throughput at 713 tok/s. Output speed is measured by routing standardized prompts through each provider's API and averaging tokens-per-second over a 7-day rolling window. Fast inference matters most for streaming chat UIs and agentic loops; for batched async workloads, blended price per 1M tokens is usually the better axis.</div></div></details><details id="faq-best-open" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">Which is the best open-source AI model?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92"><strong>GLM-5.2</strong> currently leads among open-weights LLMs (91.2% gpqa). The open-weights ecosystem is dominated by Llama, Qwen, DeepSeek, Mistral, GLM and Gemma. The dedicated <a href="/leaderboards/open-llm-leaderboard">Open LLM Leaderboard</a> filters this catalog to models with publicly released weights so you can self-host or fine-tune.</div></div></details><details id="faq-llm-stats-score" class="group block border-b border-black/[0.06] last:border-b-0 dark:border-white/[0.08] [&amp;_.faq-icon]:open:rotate-45"><summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 px-5 py-4 text-left transition-colors hover:bg-black/[0.015] dark:hover:bg-white/[0.025] sm:px-6 [&amp;::-webkit-details-marker]:hidden"><h3 class="max-w-2xl text-[15px] font-medium leading-snug tracking-[-0.005em] text-black/90 dark:text-white/90">How is the LLM Stats Score calculated?</h3><span class="faq-icon mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-black/55 transition-all group-open:rotate-45 group-open:bg-black/[0.06] group-open:text-black/85 dark:text-white/55 dark:group-open:bg-white/[0.08] dark:group-open:text-white/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></summary><div class="px-5 pb-5 pr-14 sm:px-6 sm:pr-20"><div class="max-w-2xl text-[13px] leading-[1.7] text-black/70 dark:text-white/65 [&amp;_a]:font-medium [&amp;_a]:text-black/85 [&amp;_a]:underline [&amp;_a]:underline-offset-2 [&amp;_a]:decoration-black/20 hover:[&amp;_a]:decoration-black/80 dark:[&amp;_a]:text-white/85 dark:[&amp;_a]:decoration-white/20 dark:hover:[&amp;_a]:decoration-white/80 [&amp;_strong]:font-medium [&amp;_strong]:text-black/92 dark:[&amp;_strong]:text-white/92">The LLM Stats Score is a composite that blends verified benchmark results (GPQA Diamond, SWE-Bench Verified, coding-arena), live performance metrics (output throughput, time-to-first-token) and per-token pricing into one comparable number. Pricing and metadata revalidate hourly; live performance updates on a 7-day rolling average. For the full weighting and refresh cadence see the <a href="/methodology/llm-stats-score">LLM Stats Score methodology</a>. 329 canonical models are tracked across every major lab and inference provider.</div></div></details></div></section></div></div></section></div></div><!--$--><!--/$--></main><footer class="relative w-full bg-background mt-auto"><section class="relative py-12 bg-gradient-to-b from-black/[0.015] to-black/[0.035] dark:from-white/[0.015] dark:to-white/[0.035]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-border/60 to-transparent"></div><div class="max-w-7xl mx-auto px-6 md:px-8"><div class="grid lg:grid-cols-[1fr,1.1fr] gap-10 lg:gap-16 items-center"><div class="space-y-3"><h3 class="text-[19px] font-normal text-foreground tracking-[-0.02em] leading-snug">Join our newsletter and stay up to date with everything AI</h3><p class="text-[13px] text-muted-foreground/60 max-w-md leading-[1.6]">There&#x27;s too much noise in AI, let&#x27;s filter it for you. Get a curated digest of models, benchmarks, and the analysis that matters, right in your inbox once a week.</p></div><div class="lg:justify-self-end w-full lg:max-w-md"><form><div class="flex gap-2 p-1.5 rounded-xl bg-white dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_4px_12px_rgba(0,0,0,0.02)] dark:shadow-[0_1px_2px_rgba(0,0,0,0.2),0_4px_12px_rgba(0,0,0,0.1)] transition-shadow duration-200 focus-within:shadow-[0_1px_2px_rgba(0,0,0,0.06),0_4px_16px_rgba(0,0,0,0.05)] dark:focus-within:shadow-[0_1px_2px_rgba(0,0,0,0.3),0_4px_16px_rgba(0,0,0,0.15)]"><input type="email" placeholder="you@example.com" required="" autoComplete="email" class="flex-1 h-9 rounded-lg px-3 text-sm bg-transparent text-foreground placeholder:text-muted-foreground/35 border-0 focus:outline-none transition-colors duration-150 disabled:opacity-50 disabled:cursor-not-allowed" value=""/><button type="submit" disabled="" class="h-9 px-4 rounded-lg group relative overflow-hidden text-[13px] font-medium bg-foreground text-background shadow-[0_1px_2px_rgba(0,0,0,0.1),inset_0_1px_0_rgba(255,255,255,0.1)] dark:shadow-[0_1px_2px_rgba(0,0,0,0.3),inset_0_1px_0_rgba(255,255,255,0.05)] hover:shadow-[0_2px_4px_rgba(0,0,0,0.15),inset_0_1px_0_rgba(255,255,255,0.1)] dark:hover:shadow-[0_2px_4px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.05)] active:scale-[0.98] active:shadow-[0_0px_1px_rgba(0,0,0,0.1)] transition-all duration-150 ease-out disabled:opacity-40 disabled:cursor-not-allowed disabled:active:scale-100 disabled:shadow-none focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-foreground/30"><span class="flex items-center gap-1.5"><span>Subscribe</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3.5 h-3.5 opacity-50 group-hover:opacity-90 group-hover:translate-x-0.5 transition-all duration-200 ease-out" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></button></div><p class="mt-3 text-[11px] text-muted-foreground/40 flex items-center gap-1.5">No spam, unsubscribe anytime</p></form></div></div></div></section><div class="max-w-7xl mx-auto px-6 md:px-8 pt-16 pb-12"><div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-8 gap-y-12 lg:gap-x-12 mb-20"><div class="col-span-2 md:col-span-3 lg:col-span-1"><a class="inline-flex items-center gap-2 mb-6 group" href="/"><img alt="LLM Stats Logo" loading="lazy" width="16" height="16" decoding="async" data-nimg="1" class="w-4 h-4" style="color:transparent" src="/logo.svg"/><span class="text-[15px] font-medium text-black dark:text-white tracking-[-0.01em] transition-opacity group-hover:opacity-60">llm-stats<span class="text-[12px] font-light text-black/40 dark:text-white/40">.com</span></span></a><p class="text-[13px] leading-[1.6] text-black/50 dark:text-white/50 max-w-[280px]">The AI Benchmarking Hub.</p></div><div><h3 class="text-[11px] font-medium text-black/40 dark:text-white/40 tracking-[0.06em] uppercase mb-4">Leaderboards</h3><ul class="space-y-3"><li><a class="text-[13px] text-black/60 dark:text-white/60 transition-colors hover:text-black dark:hover:text-white inline-block" href="/">AI Leaderboards</a></li><li><a class="text-[13px] text-black/60 dark:text-white/60 transition-colors hover:text-black dark:hover:text-white inline-block" href="/leaderboards/llm-leaderboard">LLM Leaderboard</a></li><li><a class="text-[13px] text-black/60 dark:text-white/60 transition-colors hover:text-black dark:hover:text-white inline-block" href="/leaderboards/open-llm-leaderboard">Open LLM Leaderboard</a></li><li><a class="text-[13px] text-black/60 dark:text-white/60 transition-colors hover:text-black dark:hover:text-white inline-block" href="/leaderboards/best-ai-for-coding">Best AI for Coding</a></li><li><a class="text-[13px] text-black/60 dark:text-white/60 transition-colors hover:text-black dark:hover:text-white inline-block" href="/leaderboards/best-ai-for-math">Best AI for Math</a></li><li><a class="text-[13px] text-black/60 dark:text-white/60 transition-colors hover:text-black dark:hover:text-white inline-block" href="/leaderboards/best-ai-for-image-generation">Best AI for Image Generation</a></li><li><a class="text-[13px] text-black/60 dark:t