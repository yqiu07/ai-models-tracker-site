fb9f3c97826f6.js\",\"48050\",\"static/chunks/app/leaderboards/open-llm-leaderboard/page-d15d15d0b465b2fa.js\"],\"\"]\n16:T5e1,{\"@context\":\"https://schema.org\",\"@type\":\"Dataset\",\"name\":\"Open LLM Leaderboard - LLM Stats\",\"description\":\"Independent ranking of open-weight large language models — Llama, Qwen, GLM, DeepSeek, Mistral, Kimi and more — by coding-arena score, GPQA Diamond, throughput, latency, and per-token pricing.\",\"url\":\"https://llm-stats.com/leaderboards/open-llm-leaderboard\",\"creator\":{\"@type\":\"Organization\",\"name\":\"LLM Stats\",\"url\":\"https://llm-stats.com\"},\"publisher\":{\"@id\":\"https://llm-stats.com/#organization\"},\"measurementTechnique\":\"Aggregated benchmark scores from public model evaluations and provider-reported results.\",\"spatialCoverage\":\"Worldwide\",\"isAccessibleForFree\":true,\"license\":\"https://llm-stats.com/legal/terms-of-service\",\"citation\":\"LLM Stats (2026). LLM benchmark and pricing dataset. https://llm-stats.com\",\"keywords\":[\"llm leaderboard\",\"ai benchmark\",\"model comparison\",\"ai pricing\",\"open llm leaderboard\"],\"variableMeasured\":[\"GPQA Diamond\",\"Coding Arena Score\",\"Output throughput (tokens/sec)\",\"Time to first token (s)\",\"Input price (USD per 1M tokens)\",\"Output price (USD per 1M tokens)\",\"Context window (tokens)\"],\"dateModified\":\"2026-05-13T02:50:41.781Z\",\"distribution\":[{\"@type\":\"DataDownload\",\"name\":\"Models list (JSON)\",\"contentUrl\":\"https://api.zeroeval.com/leaderboard/models/list\",\"encodingFormat\":\"application/json\"},{\"@type\":\"DataDownload\",\"name\":\"Per-model metrics (JSON)\",\"contentUrl\":\"https://api.zeroeval.com/v1/models/metrics\",\"encodingFormat\":\"application/json\"}]}17:T896,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the best LLM right now?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Based on coding-arena performance — the most discriminating signal at the frontier — Gemini 3.1 Pro currently leads. For knowledge-heavy reasoning (GPQA Diamond), Claude Mythos Preview scores highest. Choose by axis rather than a single ranking — see the highlights above for per-metric leaders.\"}},{\"@type\":\"Question\",\"name\":\"How does the Open LLM Leaderboard rank models?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Models are sorted by coding-arena score (when available), then by GPQA Diamond. Each row aggregates verified benchmark results, provider-reported pricing, and live performance metrics (output throughput and time-to-first-token) sampled across the major API providers. See the LLM Stats Score methodology for the full weighting and refresh cadence.\"}},{\"@type\":\"Question\",\"name\":\"How many models are tracked?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This leaderboard tracks 298 canonical models across every major lab and provider. New releases typically appear within hours.\"}},{\"@type\":\"Question\",\"name\":\"Where does pricing data come from?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Per-model input/output pricing is pulled from each provider's public API price list and verified against billing samples from the LLM Stats proxy. When a model is hosted by multiple providers, the cheapest available rate is shown by default.\"}},{\"@type\":\"Question\",\"name\":\"How is performance measured?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Output throughput (tokens/second) and time-to-first-token are measured by routing standardized prompts through each provider's API and averaging over a 7-day rolling window. Numbers update hourly. Per-model splits live on each model detail page.\"}},{\"@type\":\"Question\",\"name\":\"How often does the data update?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Pricing and model metadata revalidate every hour. Live performance metrics update on a 7-day rolling average. Benchmark scores update when a new verified result is published or a new evaluation lands on LLM Stats.\"}}]}"])</script><script>self.__next_f.push([1,"4:[[\"$\",\"$L13\",null,{}],[\"$\",\"$L14\",null,{\"initialData\":[{\"model_id\":\"gemini-3.1-pro-preview\",\"name\":\"Gemini 3.1 Pro\",\"organization\":\"Google\",\"organization_id\":\"google\",\"organization_country\":\"US\",\"params\":null,\"training_tokens\":null,\"context\":1048576,\"canonical_model_id\":null,\"release_date\":\"2026-02-19\",\"announcement_date\":\"2026-02-19\",\"multimodal\":true,\"license\":\"proprietary\",\"is_moe\":null,\"knowledge_cutoff\":\"2025-01-31\",\"input_price\":2.5,\"output_price\":15,\"throughput\":null,\"latency\":null,\"aime_2025_score\":null,\"hle_score\":0.514,\"gpqa_score\":0.943,\"swe_bench_verified_score\":0.806,\"mmmu_score\":null,\"simpleqa_score\":null,\"osworld_score\":null,\"browsecomp_score\":0.859,\"toolathlon_score\":null,\"terminal_bench_score\":null,\"tau_bench_retail_score\":null,\"arc_agi_v2_score\":0.771,\"mmmlu_score\":0.926,\"charxiv_r_score\":null,\"mmmu_pro_score\":0.805,\"screenspot_pro_score\":null,\"mcp_atlas_score\":0.692,\"frontiermath_score\":null,\"mrcr_v2_score\":0.263,\"scicode_score\":0.59,\"apex_agents_score\":0.335,\"swe_bench_pro_score\":0.542,\"coding_arena_score\":20.929425574432663,\"index_reasoning\":59.15,\"index_math\":54.76,\"index_code\":44.09,\"index_search\":37,\"index_communication\":null,\"index_vision\":41.04,\"index_tool_calling\":34.07,\"index_long_context\":14.13,\"index_finance\":4.85,\"index_legal\":4.81,\"index_healthcare\":null},{\"model_id\":\"claude-opus-4-6\",\"name\":\"Claude Opus 4.6\",\"organization\":\"Anthropic\",\"organization_id\":\"anthropic\",\"organization_country\":\"US\",\"params\":null,\"training_tokens\":null,\"context\":1000000,\"canonical_model_id\":null,\"release_date\":\"2026-02-05\",\"announcement_date\":\"2026-02-05\",\"multimodal\":true,\"license\":\"proprietary\",\"is_moe\":null,\"knowledge_cutoff\